{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(cat *)",
      "Bash(codex exec *)",
      "Bash(codex login status*)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(gemini *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git pull *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(tail *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git restore *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "ignoreViolations": {
      "git": [".git/config"]
    },
    "filesystem": {
      "allowWrite": [
        "~/.codex"
      ],
      "denyWrite": [
        "~/.codex/config.toml",
        "~/.codex/plugins",
        "~/.codex/rules",
        "~/.codex/skills",
        "~/.codex/vendor_imports",
        "~/.codex/.tmp/bundled-marketplaces"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "json.schemastore.org",
        "www.schemastore.org",
        "chatgpt.com",
        "*.openai.com"
      ]
    }
  }
}
