{
  "name": "doarakko-config",
  "description": "Commands, skills, agents, and hooks for branch management, commit splitting, PR workflows, code review, CI/CD automation, and test creation",
  "version": "1.1.0",
  "author": {
    "name": "Doarakko",
    "email": "2wua4nlyi@gmail.com"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/auto-review-session-start.sh"
            ],
            "timeout": 15
          }
        ],
        "description": "Record the worktree at session start so untouched turns stay quiet"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pr-create-guard.sh"
            ],
            "timeout": 10
          }
        ],
        "description": "Route PR creation through the pr-create workflow"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f Makefile ] && grep -q '^lint:' Makefile; then make lint 2>&1 | tail -20; fi"
          }
        ],
        "description": "Run make lint after file edits"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/auto-review.sh"
            ],
            "timeout": 30,
            "statusMessage": "未レビューの差分を確認中..."
          }
        ],
        "description": "Review uncommitted changes before finishing"
      }
    ]
  }
}
